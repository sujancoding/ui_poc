    "@typescript-eslint/eslint-plugin": "4.28.2",
    "@typescript-eslint/parser": "4.28.2",
    "ajv": "^8.17.1",
    "body-parser": "^1.19.0",
    "codelyzer": "^0.0.28",
    "compodoc": "^0.0.6",
    "concurrently": "^6.3.0",
    "eslint": "^9.23.0",
    "generate-changelog": "^1.8.0",
    "husky": "^7.0.2",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "json-concat": "^0.0.1",
    "json-server": "^0.17.0",
    "jsonwebtoken": "^9.0.2",
    "karma": "~6.3.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "prettier": "^2.4.1",
    "protractor": "^7.0.0",
    "ts-node": "~8.3.0",
