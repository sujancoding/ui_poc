{
  "name": "mbank_ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node --max_old_space_size=16192 ./node_modules/@angular/cli/bin/ng serve",
    "macstart": "node --max_old_space_size=16192    --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng serve",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "native": "ng build --prod --base-href ./ --output-path ../mbank_native/www/",
    "serve:sw": "npm run buildprod -s && npx http-server ./dist -p 4200",
    "buildprod": "ng build  --prod",
    "build": "npm run lint && ng build",
    "build:prod": "npm run lint && ng build --prod",
    "build:bundle-report": "ng build --stats-json && webpack-bundle-analyzer dist/mbank_ui/stats.json",
    "build:bundle-report:prod": "ng build --prod --stats-json && webpack-bundle-analyzer dist/mbank_ui/stats.json",
    "mock:server": "npm run concat:mocks && json-server --watch mocks/db.json --routes mocks/routes.json",
    "macstart:proxy": "node --max_old_space_size=16192  --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.conf.json --host=0.0.0.0 --disable-host-check",
    "start:proxy": "node --max_old_space_size=16192 ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.conf.json --host=0.0.0.0 --disable-host-check",
    "start:proxy:mock:server": "concurrently --kill-others \"npm run mock:server\" \"npm run start:proxy\"",
    "concat:mocks": "node \"./mocks/concat-json.js\"",
    "compodoc": "npx compodoc -p tsconfig.app.json",
    "changelog": "changelog",
    "analyze": "webpack-bundle-analyzer dist/mbank_ui/stats-es2015.json",
    "prettier": "prettier --write \"src/app/**/*.{js,json,css,scss,less,md,ts,html,component.html}\"",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/core": "^15.2.11",
    "@angular-devkit/schematics": "^15.2.11",
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/flex-layout": "^14.0.0-beta.41",
    "@angular/forms": "^15.2.10",
    "@angular/material": "^15.2.9",
    "@angular/material-moment-adapter": "^15.2.9",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/pwa": "^14.2.0",
    "@angular/router": "^15.2.10",
    "@angular/service-worker": "^15.2.10",
    "@material/chips": "^14.0.0",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@swimlane/ngx-charts": "^20.5.0",
    "@swimlane/ngx-datatable": "^20.0.0",
    "@types/d3-shape": "^1.3.2",
    "angular-calendar": "^0.28.26",
    "apexcharts": "^3.16.0",
    "c3": "^0.4.24",
    "chart.js": "^2.9.3",
    "chartist": "^0.11.4",
    "core-js": "^3.6.4",
