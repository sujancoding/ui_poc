    "ng2-dragula": "^2.1.1",
    "ng2-file-upload": "^1.4.0",
    "ng2-search-filter": "^0.5.1",
    "ngx-custom-validators": "^8.0.0",
    "ngx-pagination": "^5.0.0",
    "ngx-perfect-scrollbar": "^8.0.0",
    "ngx-quill": "^25.0.3",
    "quill": "^2.0.3",
    "rxjs": "~6.6.0",
    "rxjs-compat": "^6.5.4",
    "sass": "1.54.0 --save-dev",
    "swiper": "^8.1.4",
    "tslib": "^2.0.0",
